<Window x:Class="GI_Subtitles.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GI_Subtitles.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        Height="20"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False">
    <Window.Resources>
        <ControlTemplate x:Key="DebugControlButtonTemplate" TargetType="{x:Type Button}">
            <Border x:Name="ButtonChrome"
                    CornerRadius="3"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ButtonChrome" Property="Background" Value="#CC59697B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="DebugRestoreButtonTemplate" TargetType="{x:Type Button}">
            <Border x:Name="ButtonChrome"
                    CornerRadius="18"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ButtonChrome" Property="Background" Value="#CC59697B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <DataTemplate x:Key="DebugMinimizeGlyphTemplate">
            <Grid Width="12" Height="12">
                <Rectangle Width="9" Height="1.5" Fill="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DebugCloseGlyphTemplate">
            <Grid Width="12" Height="12">
                <Rectangle Width="11" Height="1.5" Fill="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="45"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Width="11" Height="1.5" Fill="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="-45"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DebugRestoreGlyphTemplate">
            <Grid Width="12" Height="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="4"/>
                </Grid.RowDefinitions>
                <Rectangle Grid.Row="0" Width="10" Height="1.4" Fill="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Rectangle Grid.Row="1" Width="7" Height="1.4" Fill="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Rectangle Grid.Row="2" Width="10" Height="1.4" Fill="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="False">
        <Button x:Name="DragButton"
                Width="20" Height="20"
                Canvas.Left="0"
                Canvas.Top="0"
                Background="#00FFFFFF"
                BorderThickness="0"
                Cursor="SizeAll"
                Visibility="Collapsed"
                Panel.ZIndex="8"
                IsHitTestVisible="True"
                Focusable="False">
            <Image Source="../Resources/drag.png" Stretch="Uniform" Width="20" Height="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        </Button>
        <TextBox x:Name="SubtitleText"
                 TextWrapping="Wrap"
                 FontFamily="{DynamicResource SubtitleFontFamily}"
                 Foreground="White"
                 TextAlignment="Center"
                 FontWeight="Bold"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Background="Transparent"
                 BorderThickness="0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 IsHitTestVisible="False"/>

        <TextBlock x:Name="DarkScreenText"
                   TextWrapping="Wrap"
                   FontFamily="{DynamicResource SubtitleFontFamily}"
                   Foreground="White"
                   TextAlignment="Center"
                   FontWeight="Bold"
                   Background="Transparent"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>
        <TextBlock x:Name="DialogueChoiceText"
                   TextWrapping="Wrap"
                   FontFamily="{DynamicResource SubtitleFontFamily}"
                   Foreground="White"
                   TextAlignment="Center"
                   FontWeight="Bold"
                   FontSize="14"
                   Visibility="Collapsed"
                   IsHitTestVisible="False">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="-20"/>
            </TextBlock.RenderTransform>
        </TextBlock>
        <Grid x:Name="HeaderPanel"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              IsHitTestVisible="False">
            <TextBlock x:Name="HeaderText"
                       TextWrapping="Wrap"
                       FontFamily="{DynamicResource SubtitleFontFamily}"
                       Foreground="White"
                       TextAlignment="Center"
                       FontWeight="Bold"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <Border x:Name="PlaybackSpeedBadge"
                    Margin="6,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="PlaybackSpeedText"
                           Foreground="{Binding ElementName=HeaderText, Path=Foreground}"
                           FontWeight="Normal"
                           FontSize="11"
                           Opacity="0.72"
                           Text=""/>
            </Border>
        </Grid>

        <Border x:Name="DebugSamplingPanel"
                Width="760"
                Height="158"
                Padding="8"
                Background="#80202733"
                BorderBrush="#CC69D7F5"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="100000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="DebugResourceText"
                           Grid.Row="0"
                           Foreground="#FF8DE8FF"
                           FontFamily="Consolas"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,0,28,5"
                           Text="CPU -- | Memory --"/>
                <ScrollViewer x:Name="DebugSamplingScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              IsHitTestVisible="False">
                    <TextBlock x:Name="DebugSamplingText"
                               Foreground="#FFF4F7FB"
                               FontFamily="Consolas"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"/>
                </ScrollViewer>
            </Grid>
        </Border>
        <Button x:Name="DebugSamplingMinimizeButton"
                Width="22" Height="22"
                Content="Minimize"
                ContentTemplate="{StaticResource DebugMinimizeGlyphTemplate}"
                Foreground="White"
                Background="#CC3A4656"
                BorderBrush="Transparent"
                BorderThickness="0"
                Padding="0"
                Cursor="Hand"
                Visibility="Collapsed"
                IsHitTestVisible="True"
                Focusable="False"
                ToolTip="{DynamicResource Debug_MinimizeTooltip}"
                Click="DebugSamplingMinimizeButton_Click"
                Template="{StaticResource DebugControlButtonTemplate}"
                Panel.ZIndex="100002"/>
        <Button x:Name="DebugSamplingCloseButton"
                Width="22" Height="22"
                Content="Close"
                ContentTemplate="{StaticResource DebugCloseGlyphTemplate}"
                Foreground="White"
                Background="#CC3A4656"
                BorderBrush="Transparent"
                BorderThickness="0"
                Padding="0"
                Cursor="Hand"
                Visibility="Collapsed"
                IsHitTestVisible="True"
                Focusable="False"
                Template="{StaticResource DebugControlButtonTemplate}"
                Click="DebugSamplingCloseButton_Click"
                Panel.ZIndex="100001"/>
    </Canvas>
</Window>
