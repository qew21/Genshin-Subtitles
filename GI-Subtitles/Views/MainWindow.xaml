<Window x:Class="GI_Subtitles.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GI_Subtitles.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        Height="20"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False">
    <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="False">
        <Button x:Name="DragButton"
                Width="20" Height="20"
                Canvas.Left="0"
                Canvas.Top="0"
                Background="#00FFFFFF"
                BorderThickness="0"
                Cursor="SizeAll"
                Visibility="Collapsed"
                Panel.ZIndex="8"
                IsHitTestVisible="True"
                Focusable="False">
            <Image Source="../Resources/drag.png" Stretch="Uniform" Width="20" Height="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        </Button>
        <TextBox x:Name="SubtitleText"
                 TextWrapping="Wrap"
                 FontFamily="{DynamicResource SubtitleFontFamily}"
                 Foreground="White"
                 TextAlignment="Center"
                 FontWeight="Bold"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Background="Transparent"
                 BorderThickness="0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 IsHitTestVisible="False"/>

        <TextBlock x:Name="DarkScreenText"
                   TextWrapping="Wrap"
                   FontFamily="{DynamicResource SubtitleFontFamily}"
                   Foreground="White"
                   TextAlignment="Center"
                   FontWeight="Bold"
                   Background="Transparent"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>
        <TextBlock x:Name="DialogueChoiceText"
                   TextWrapping="Wrap"
                   FontFamily="{DynamicResource SubtitleFontFamily}"
                   Foreground="White"
                   TextAlignment="Center"
                   FontWeight="Bold"
                   FontSize="14"
                   Visibility="Collapsed"
                   IsHitTestVisible="False">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="-20"/>
            </TextBlock.RenderTransform>
        </TextBlock>
        <Grid x:Name="HeaderPanel"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              IsHitTestVisible="False">
            <Grid.RenderTransform>
                <TranslateTransform Y="-20"/>
            </Grid.RenderTransform>
            <TextBlock x:Name="HeaderText"
                       TextWrapping="Wrap"
                       FontFamily="{DynamicResource SubtitleFontFamily}"
                       Foreground="White"
                       TextAlignment="Center"
                       FontWeight="Bold"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <Border x:Name="PlaybackSpeedBadge"
                    Margin="6,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="PlaybackSpeedText"
                           Foreground="{Binding ElementName=HeaderText, Path=Foreground}"
                           FontWeight="Normal"
                           FontSize="11"
                           Opacity="0.72"
                           Text=""/>
            </Border>
        </Grid>

        <Border x:Name="DebugSamplingPanel"
                Width="760"
                Height="158"
                Padding="8"
                Background="#E6202733"
                BorderBrush="#CC69D7F5"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Panel.ZIndex="100000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="DebugResourceText"
                           Grid.Row="0"
                           Foreground="#FF8DE8FF"
                           FontFamily="Consolas"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,0,28,5"
                           Text="CPU -- | Memory --"/>
                <ScrollViewer x:Name="DebugSamplingScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              IsHitTestVisible="False">
                    <TextBlock x:Name="DebugSamplingText"
                               Foreground="#FFF4F7FB"
                               FontFamily="Consolas"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"/>
                </ScrollViewer>
            </Grid>
        </Border>
        <Button x:Name="DebugSamplingCloseButton"
                Width="22" Height="22"
                Content="×"
                FontSize="17"
                FontWeight="Bold"
                Foreground="White"
                Background="#CC3A4656"
                BorderThickness="0"
                Cursor="Hand"
                Visibility="Collapsed"
                IsHitTestVisible="True"
                Focusable="False"
                Click="DebugSamplingCloseButton_Click"
                Panel.ZIndex="100001"/>
    </Canvas>
</Window>
