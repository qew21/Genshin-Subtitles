<Window x:Class="GI_Subtitles.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GI_Subtitles.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        Height="20"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False">
    <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="False">
        <Button x:Name="DragButton"
                Width="20" Height="20"
                Canvas.Left="0"
                Canvas.Top="0"
                Background="#00FFFFFF"
                BorderThickness="0"
                Cursor="SizeAll"
                Visibility="Collapsed"
                Panel.ZIndex="8"
                IsHitTestVisible="False">
            <Image Source="../Resources/drag.png" Stretch="Uniform" Width="20" Height="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        </Button>
        <TextBox x:Name="SubtitleText"
                 TextWrapping="Wrap"
                 FontFamily="{DynamicResource SubtitleFontFamily}"
                 Foreground="White"
                 TextAlignment="Center"
                 FontWeight="Bold"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Background="Transparent"
                 BorderThickness="0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 IsHitTestVisible="False"/>

        <TextBlock x:Name="DarkScreenText"
                   TextWrapping="Wrap"
                   FontFamily="{DynamicResource SubtitleFontFamily}"
                   Foreground="White"
                   TextAlignment="Center"
                   FontWeight="Bold"
                   Background="Transparent"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"/>
        <TextBlock x:Name="DialogueChoiceText"
                   TextWrapping="Wrap"
                   FontFamily="{DynamicResource SubtitleFontFamily}"
                   Foreground="White"
                   TextAlignment="Center"
                   FontWeight="Bold"
                   FontSize="14"
                   Visibility="Collapsed"
                   IsHitTestVisible="False">
            <TextBlock.RenderTransform>
                <TranslateTransform Y="-20"/>
            </TextBlock.RenderTransform>
        </TextBlock>
        <StackPanel x:Name="HeaderPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False">
            <StackPanel.RenderTransform>
                <TranslateTransform Y="-20"/>
            </StackPanel.RenderTransform>
            <TextBlock x:Name="HeaderText"
                       TextWrapping="Wrap"
                       FontFamily="{DynamicResource SubtitleFontFamily}"
                       Foreground="White"
                       TextAlignment="Center"
                       FontWeight="Bold"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <Border x:Name="PlaybackSpeedBadge"
                    Margin="6,0,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="PlaybackSpeedText"
                           Foreground="{Binding ElementName=HeaderText, Path=Foreground}"
                           FontWeight="Normal"
                           FontSize="11"
                           Opacity="0.72"
                           Text=""/>
            </Border>
        </StackPanel>
    </Canvas>
</Window>
