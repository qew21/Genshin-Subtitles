<Window x:Class="GI_Subtitles.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App_Settings}"
        Height="680" Width="980"
        MinHeight="520" MinWidth="760"
        Icon="../Resources/mask.ico" 
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F8FAFD"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D8E0EA"/>
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#C5D0DE"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4338CA"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF7DB"/>
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#F0C36A"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>

        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small question-mark help button -->
        <Style TargetType="Button" x:Key="HelpButton">
            <Setter Property="MinWidth" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Content" Value="?"/>
            <Setter Property="ToolTip" Value="{DynamicResource Help_ClickToView}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="0" BorderThickness="0" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="IconActionButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Link-style TextBox -->
        <Style TargetType="TextBox" x:Key="LinkTextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#E4EAF2"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Margin="0,8,0,0"
                                    Padding="14,18,14,14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <ContentPresenter/>
                            </Border>
                            <Border HorizontalAlignment="Left"
                                    Margin="12,0,0,0"
                                    Padding="6,0"
                                    Background="{StaticResource WindowBackgroundBrush}">
                                <ContentPresenter ContentSource="Header"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      IsItemsHost="True"
                                      Margin="4,0,4,8"
                                      Background="Transparent"/>
                            <Border Grid.Row="1"
                                    Background="{StaticResource SurfaceSubtleBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <ContentPresenter ContentSource="SelectedContent"
                                                  Margin="1"
                                                  SnapsToDevicePixels="True"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Warning banner for missing Genshin Medium data -->
        <Border x:Name="IncompleteDataWarning" 
                Grid.Row="0"
                Background="{StaticResource WarningSoftBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}"
                BorderThickness="1" 
                Padding="14,10"
                Margin="0,0,0,16"
                CornerRadius="10"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="18" Foreground="#FFBA00" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Incomplete_Data_Warning}" 
                           TextWrapping="Wrap" 
                           Foreground="#333333" 
                           FontSize="13"
                           VerticalAlignment="Center"
                           MaxWidth="750"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="SettingsTabs" Grid.Row="1">
            <!-- Tab 1: Language & Data Management -->
            <TabItem Header="{DynamicResource Tab_Language}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Control panel: language & game selection -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18">
                        <WrapPanel HorizontalAlignment="Center">
                            <!-- UI language control is now moved to tray Language menu, keep hidden here for compatibility -->
                            <TextBlock Text="{DynamicResource UI_Language}" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Visibility="Collapsed"/>
                            <ComboBox Name="UILangSelector" Width="100" VerticalAlignment="Center" Margin="0,0,16,0"
                                      SelectionChanged="UILangSelector_SelectionChanged"
                                      Visibility="Collapsed">
                                <ComboBoxItem Content="简体中文" Tag="zh-CN" IsSelected="True"/>
                                <ComboBoxItem Content="English" Tag="en-US"/>
                                <ComboBoxItem Content="日本語" Tag="ja-JP"/>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                                <TextBlock Text="{DynamicResource Select_Game}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Name="GameSelector" Width="120" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                                <TextBlock Text="{DynamicResource Recognize_Lang}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Name="InputSelector" Width="100" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Multi-select output languages (max 2), apply by confirm button -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Output_Lang}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ListBox Name="OutputSelector"
                                         Width="150"
                                         Height="80"
                                         SelectionMode="Multiple">
                                </ListBox>
                                <Button x:Name="OutputConfirmButton"
                                        Content="Apply"
                                        Width="70"
                                        Height="30"
                                        Margin="8,0,0,0"
                                        Click="OutputConfirmButton_Click"
                                        IsEnabled="False"/>
                            </StackPanel>
                        </WrapPanel>
                        </Border>

                        <!-- Data information area -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,18">
                            <GroupBox Header="{DynamicResource Local_File_Info}">
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{DynamicResource Recognize_Lang}"/>
                                        <TextBlock Name="inputFilePathDate" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0">
                                        <Run Text="{DynamicResource Output_Lang}"/>
                                        <TextBlock Name="outputFilePathDate" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </TextBlock>
                                    <!-- Optional second output language local file info -->
                                    <TextBlock Margin="0,4,0,0">
                                        <Run Text="{DynamicResource Output_Lang}"/>
                                        <TextBlock Name="outputFilePathDate2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </TextBlock>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{DynamicResource Repo_Info}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{DynamicResource Repo_Last_Modified}"/>
                                        <TextBlock Name="RepoModifiedDate" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </TextBlock>
                                    <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                        <CheckBox x:Name="DownloadInputCheckBox"
                                                  Content="{DynamicResource Download_Input_Lang}"
                                                  IsChecked="True" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="InputLangDownloadUrl" Style="{StaticResource LinkTextBox}" Text="" 
                                                 Cursor="Hand" MouseLeftButtonUp="UrlTextBox_MouseLeftButtonUp" IsReadOnly="True"
                                                 ToolTip="Click to copy URL"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                        <CheckBox x:Name="DownloadOutputCheckBox"
                                                  Content="{DynamicResource Download_Output_Lang}"
                                                  IsChecked="True" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="OutputLangDownloadUrl" Style="{StaticResource LinkTextBox}" Text="" 
                                                 Cursor="Hand" MouseLeftButtonUp="UrlTextBox_MouseLeftButtonUp" IsReadOnly="True"
                                                 ToolTip="Click to copy URL"/>
                                    </DockPanel>
                                    <!-- Optional second output language download link (when multi-output is enabled) -->
                                    <DockPanel x:Name="SecondOutputDownloadPanel" Margin="0,4,0,0" LastChildFill="True">
                                        <CheckBox x:Name="DownloadOutput2CheckBox"
                                                  Content="{DynamicResource Download_Output_Lang}"
                                                  IsChecked="True" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="OutputLangDownloadUrl2" Style="{StaticResource LinkTextBox}" Text="" 
                                                 Cursor="Hand" MouseLeftButtonUp="UrlTextBox_MouseLeftButtonUp" IsReadOnly="True"
                                                 ToolTip="Click to copy URL"/>
                                    </DockPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Progress bar and download speed -->
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <ProgressBar Name="DownloadProgressBar" Minimum="0" Maximum="100"/>
                            <TextBlock Name="DownloadSpeedText" Margin="0,8,0,0" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>

                        <Label Grid.Row="4" Name="Status" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Content="Loading..."/>
                        <Image Grid.Row="5" Name="Capture" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Stretch="Uniform" MaxHeight="180"/>

                        <!-- Action buttons -->
                        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Button x:Name="SyncButton" Style="{StaticResource PrimaryButton}" 
                                    Content="{DynamicResource Btn_Sync}" Click="SyncButton_Click"
                                    ToolTip="{DynamicResource Help_Sync}"/>
                            <Button x:Name="DownloadButton" Style="{StaticResource PrimaryButton}"
                                    Content="{DynamicResource Btn_Download_All}" Click="DownloadButton_Click"
                                    ToolTip="{DynamicResource Help_Download_All}"/>
                            <Button x:Name="RestartButton" Style="{StaticResource PrimaryButton}"
                                    Content="{DynamicResource Btn_Restart}" Click="RestartButton_Click"
                                    ToolTip="{DynamicResource Help_Restart}"/>
                            <Button x:Name="VideoButton" Style="{StaticResource PrimaryButton}"
                                    Content="{DynamicResource Btn_Video}" Click="VideoButton_Click"
                                    ToolTip="{DynamicResource Help_Video}"/>
                            <Button x:Name="ConvertButton" Style="{StaticResource PrimaryButton}"
                                    Content="{DynamicResource Btn_Convert}" Click="ConvertButton_Click"
                                    ToolTip="{DynamicResource Help_Convert}"/>
                            <Button x:Name="RegionButton" Style="{StaticResource PrimaryButton}"
                                    Content="{DynamicResource Btn_Region}" Click="RegionButton_Click"
                                    ToolTip="{DynamicResource Help_Region}"/>
                        </WrapPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Hotkey Settings -->
            <TabItem Header="{DynamicResource Tab_Hotkeys}">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView x:Name="hotkeyListView" Margin="0,0,0,16">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Description}" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="10,0,0,0">
                                            <CheckBox Content="Ctrl" IsChecked="{Binding IsCtrl}" Margin="0,0,12,0"/>
                                            <CheckBox Content="Shift" IsChecked="{Binding IsShift}" Margin="0,0,12,0"/>
                                            <ComboBox ItemsSource="{Binding AvailableKeys}" SelectedItem="{Binding SelectedKey}"
                                                      Width="86"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Btn_Save}" x:Name="saveButton" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="{DynamicResource Btn_ResetDefault}" x:Name="resetButton" MinWidth="100"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 3: Region pairs -->
            <TabItem Header="{DynamicResource Tab_RegionPairs}">
                <DockPanel Margin="18">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button x:Name="AddRegionPairButton"
                                Content="{DynamicResource Btn_AddRegionPair}"
                                Style="{StaticResource PrimaryButton}"
                                Click="AddRegionPair_Click"/>
                        <Button Content="{DynamicResource Btn_PreviewAll}"
                                 Style="{StaticResource PrimaryButton}"
                                 Click="PreviewAll_Click"/>
                    </StackPanel>
                    <Border x:Name="RegionPairMigrationNotice"
                            DockPanel.Dock="Top"
                            Background="{StaticResource WarningSoftBrush}"
                            BorderBrush="{StaticResource WarningBorderBrush}"
                            BorderThickness="1"
                            Padding="10,8"
                            Margin="0,0,0,10"
                            CornerRadius="10"
                            Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource RegionPair_MigrationReviewMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="#5A4300"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid x:Name="RegionPairEmptyState" Margin="0,0,0,12" MinHeight="86">
                                <Rectangle Stroke="{StaticResource BorderStrongBrush}" StrokeDashArray="4 3" StrokeThickness="1" Fill="{StaticResource SurfaceBrush}" RadiusX="10" RadiusY="10"/>
                                <TextBlock Margin="16,12"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource RegionPair_Empty}"/>
                            </Grid>
                            <ItemsControl x:Name="RegionPairCards">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Cursor="Hand"
                                                MouseLeftButtonDown="RegionPairCard_MouseLeftButtonDown">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                    <Setter Property="Padding" Value="12"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVoicePrimary}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
                                                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                                    <Button DockPanel.Dock="Right"
                                                            Content="🗑"
                                                            Style="{StaticResource IconActionButton}"
                                                            ToolTip="{DynamicResource Btn_DeletePair_Tooltip}"
                                                            AutomationProperties.Name="{DynamicResource Btn_DeletePair}"
                                                            Tag="{Binding Id}"
                                                            Click="DeleteRegionPair_Click"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{DynamicResource RegionPair_PairLabel}"
                                                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Ordinal}"
                                                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                                                   Margin="4,0,0,0"/>
                                                        <Border Margin="8,0,0,0" Padding="7,2" Background="{StaticResource WarningSoftBrush}"
                                                                Visibility="{Binding IsOverAddCap, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{DynamicResource RegionPair_OverCap}"
                                                                       Foreground="#8A5A00" FontSize="11"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{DynamicResource Btn_BoxRegion}"
                                                            ToolTip="{DynamicResource RegionPair_BoxCaptureTooltip}"
                                                            Padding="8,2"
                                                            Margin="0,0,8,0"
                                                            Tag="{Binding Id}"
                                                            Click="BoxCapture_Click"/>
                                                    <TextBlock Grid.Column="1" Text="{DynamicResource RegionPair_Capture}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding CaptureText}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CaptureText}" Value="">
                                                                        <Setter Property="Text" Value="{DynamicResource RegionPair_Unset}"/>
                                                                        <Setter Property="Foreground" Value="Gray"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="{DynamicResource Btn_BoxRegion}"
                                                            ToolTip="{DynamicResource RegionPair_BoxDisplayTooltip}"
                                                            Padding="8,2"
                                                            Margin="0,0,8,0"
                                                            Tag="{Binding Id}"
                                                            Click="BoxDisplay_Click"/>
                                                    <TextBlock Grid.Column="1" Text="{DynamicResource RegionPair_Display}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding DisplayText}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DisplayText}" Value="">
                                                                        <Setter Property="Text" Value="{DynamicResource RegionPair_Unset}"/>
                                                                        <Setter Property="Foreground" Value="Gray"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Padding="10,2"
                                                            Tag="{Binding Id}"
                                                            Click="AdjustRegion_Click"
                                                            Margin="0,0,8,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                                                <Setter Property="Content" Value="{DynamicResource Btn_AdjustRegion}"/>
                                                                <Setter Property="IsEnabled" Value="{Binding CanAdjustRegion}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAdjustArmed}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="True"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Padding="10,2"
                                                            Tag="{Binding Id}"
                                                            Click="DesignateVoicePrimary_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                                                <Setter Property="Content" Value="{DynamicResource Btn_SetVoicePrimary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVoicePrimary}" Value="True">
                                                                        <Setter Property="Content" Value="{DynamicResource Btn_VoicePrimaryOn}"/>
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Tab 4: Configuration -->
            <TabItem Header="{DynamicResource Tab_Config}">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- OCR interval -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Config_OcrInterval_Label}" VerticalAlignment="Center" Width="200"/>
                            <TextBox x:Name="OcrIntervalTextBox" Width="60" VerticalContentAlignment="Center"
                                     LostFocus="OcrIntervalTextBox_LostFocus"/>
                            <TextBlock Text="ms" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="OcrIntervalOutOfRangeWarning"
                                   Margin="200,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontStyle="Italic"
                                   Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Subtitle idle timeout -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Config_SubtitleIdleTimeout_Label}" VerticalAlignment="Center" Width="200"/>
                            <TextBox x:Name="SubtitleIdleTimeoutTextBox" Width="60" VerticalContentAlignment="Center"
                                     LostFocus="SubtitleIdleTimeoutTextBox_LostFocus"/>
                            <TextBlock Text="{DynamicResource Config_SubtitleIdleTimeout_Unit}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Config_SubtitleIdleTimeout_Help}"
                                   Margin="200,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <!-- Boolean Flags -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                        <CheckBox x:Name="AutoStartCheckBox" Checked="AutoStartCheckBox_Checked" Unchecked="AutoStartCheckBox_Checked" Content="{DynamicResource Config_AutoStart}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox x:Name="PlayVoiceCheckBox"
                                      Checked="PlayVoiceCheckBox_Checked"
                                      Unchecked="PlayVoiceCheckBox_Checked"
                                      Content="{DynamicResource Config_PlayVoice}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"/>
                            <Button Content="{DynamicResource Btn_TestVoice}"
                                    ToolTip="{DynamicResource Btn_TestVoice_Tooltip}"
                                    Click="TestVoice_Click"
                                    Padding="10,2"/>
                        </StackPanel>
                        <TextBlock x:Name="VoicePrimaryHint"
                                   Margin="22,0,0,6"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontStyle="Italic"/>
                        <CheckBox x:Name="RecognizeDarkScreenSubtitlesCheckBox"
                                  Checked="RecognizeDarkScreenSubtitlesCheckBox_Checked"
                                  Unchecked="RecognizeDarkScreenSubtitlesCheckBox_Checked"
                                  Content="{DynamicResource Config_RecognizeDarkScreenSubtitles}"
                                  ToolTip="{DynamicResource Config_RecognizeDarkScreenSubtitles_Tooltip}"
                                  Margin="0,0,0,6"/>
                        <StackPanel x:Name="DarkScreenDisplayRow" Margin="22,0,0,10" Visibility="Collapsed">
                            <TextBlock x:Name="DarkScreenDisplayStatus"
                                       Margin="0,0,0,6"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{DynamicResource ExtraPath_BoxDisplay}"
                                        Click="BoxDarkScreenDisplay_Click"
                                        Padding="10,2"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="AdjustDarkScreenDisplayButton"
                                        Content="{DynamicResource Btn_AdjustRegion}"
                                        Click="AdjustDarkScreenDisplay_Click"
                                        Padding="10,2"
                                        Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource ExtraPath_ClearDefault}"
                                        Click="ClearDarkScreenDisplay_Click"
                                        Padding="10,2"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="DialogueOptionScanPanel">
                            <CheckBox x:Name="RecognizeDialogueOptionsCheckBox"
                                      Checked="RecognizeDialogueOptionsCheckBox_Checked"
                                      Unchecked="RecognizeDialogueOptionsCheckBox_Checked"
                                      Content="{DynamicResource Config_RecognizeDialogueOptions}"
                                      ToolTip="{DynamicResource Config_RecognizeDialogueOptions_Tooltip}"
                                      Margin="0,0,0,6"/>
                            <StackPanel x:Name="DialogueOptionDisplayRow" Margin="22,0,0,10" Visibility="Collapsed">
                                <TextBlock x:Name="DialogueOptionDisplayStatus"
                                           Margin="0,0,0,6"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource ExtraPath_BoxDisplay}"
                                            Click="BoxDialogueOptionDisplay_Click"
                                            Padding="10,2"
                                            Margin="0,0,8,0"/>
                                    <Button x:Name="AdjustDialogueOptionDisplayButton"
                                            Content="{DynamicResource Btn_AdjustRegion}"
                                            Click="AdjustDialogueOptionDisplay_Click"
                                            Padding="10,2"
                                            Margin="0,0,8,0"/>
                                    <Button Content="{DynamicResource ExtraPath_ClearDefault}"
                                            Click="ClearDialogueOptionDisplay_Click"
                                            Padding="10,2"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <CheckBox x:Name="LogDenoiseCheckBox"
                                  Checked="LogDenoiseCheckBox_Checked"
                                  Unchecked="LogDenoiseCheckBox_Checked"
                                  Content="{DynamicResource Config_LogDenoise}"
                                  ToolTip="{DynamicResource Config_LogDenoise_Tooltip}"
                                  Margin="0,0,0,6"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <WrapPanel HorizontalAlignment="Left">
                            <Button Content="{DynamicResource Btn_OpenFolder}" Margin="0,0,12,0" Click="OpenAppDataFolder_Click"/>
                            <Button Content="{DynamicResource Btn_ActivityLog}" Margin="0,0,12,0" Click="OpenActivityLog_Click"/>
                            <Button Content="{DynamicResource Btn_SubtitleFont}" Margin="0,0,12,0" Click="FontPreview_Click"/>
                        </WrapPanel>
                    </Border>

                </Grid>
            </TabItem>

            <!-- Tab 4: Help / About -->
            <TabItem Header="{DynamicResource Tab_Help}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Margin="12" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource App_HelpTitle}" Style="{StaticResource SectionTitle}" Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                        <!-- First row: GitHub -->
                        <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="Github:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock VerticalAlignment="Center">
            <Hyperlink NavigateUri="https://github.com/qew21/GI-Subtitles" 
                       RequestNavigate="Hyperlink_RequestNavigate">
                https://github.com/qew21/GI-Subtitles
            </Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <!-- Second row: Wiki -->
                        <StackPanel Orientation="Horizontal" Grid.Row="2" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="Wiki:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://www.2langs.com/gi" 
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    https://www.2langs.com/gi
                                </Hyperlink>            
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="{DynamicResource Help_Instructions}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,24,0,10"/>

                        <TextBlock Grid.Row="4" Text="{DynamicResource Help_Step1}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Grid.Row="5" Text="{DynamicResource Help_Step2}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Grid.Row="6" Text="{DynamicResource Help_Step3}"
                                   TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{StaticResource TextSecondaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Grid.Row="7" HorizontalAlignment="Center">
                            <Image Width="184" Height="155" Source="../Resources/qrcode.jpg"/>
                        </StackPanel>
                    </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
