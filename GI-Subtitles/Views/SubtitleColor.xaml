<Window x:Class="GI_Subtitles.Views.SubtitleColor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SubtitleColorWindow}"
        Width="600"
        Height="540"
        MinWidth="600"
        MinHeight="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="ColorWindowTextBrush" Color="#172033"/>
        <SolidColorBrush x:Key="ColorWindowSecondaryBrush" Color="#667085"/>
        <SolidColorBrush x:Key="ColorWindowBorderBrush" Color="#D8E0EA"/>
        <SolidColorBrush x:Key="ColorWindowAccentBrush" Color="#1677FF"/>

        <Style TargetType="Button" x:Key="DialogButton">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource ColorWindowTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorWindowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ColorWindowAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryDialogButton" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#1677FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1677FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0958D9"/>
                    <Setter Property="BorderBrush" Value="#0958D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="148"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource SubtitleColor_Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ColorWindowTextBrush}"/>
            <TextBlock Text="{DynamicResource SubtitleColor_Description}"
                       Margin="0,5,0,0"
                       Foreground="{StaticResource ColorWindowSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource ColorWindowBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,16">
            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Column="0" Grid.RowSpan="2" Background="#172033" CornerRadius="7,0,0,7"/>
                <Border Grid.Column="1" Grid.RowSpan="2" Background="#D6D2C9" CornerRadius="0,7,7,0"/>
                <TextBlock Grid.Column="0" Grid.Row="0"
                           Text="{DynamicResource SubtitleColor_DarkScene}"
                           Foreground="#D7DEEA"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Grid.Row="0"
                           Text="{DynamicResource SubtitleColor_LightScene}"
                           Foreground="#515968"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="DarkScenePreview"
                           Grid.Column="0" Grid.Row="1"
                           Text="{DynamicResource SubtitleColor_SampleText}"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="8,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.85" BlurRadius="3" ShadowDepth="1"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="LightScenePreview"
                           Grid.Column="1" Grid.Row="1"
                           Text="{DynamicResource SubtitleColor_SampleText}"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="8,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.85" BlurRadius="3" ShadowDepth="1"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource SubtitleColor_Presets}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ColorWindowTextBrush}"
                       Margin="0,0,0,6"/>
            <WrapPanel x:Name="PresetColorPanel"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource SubtitleColor_Custom}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ColorWindowTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <TextBox x:Name="HexInput"
                     Grid.Column="1"
                     Width="112"
                     Height="36"
                     MaxLength="7"
                     Text="#FFFFFF"
                     CharacterCasing="Upper"
                     VerticalContentAlignment="Center"
                     Padding="10,4"
                     TextChanged="HexInput_TextChanged"/>
            <Border x:Name="CustomColorPreview"
                    Grid.Column="2"
                    Width="28"
                    Height="28"
                    Margin="10,0,0,0"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource ColorWindowBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"/>
            <Button Grid.Column="4"
                    Content="{DynamicResource SubtitleColor_Reset}"
                    Style="{StaticResource DialogButton}"
                    Margin="0"
                    Click="ResetButton_Click"/>
        </Grid>
        <TextBlock x:Name="ValidationText"
                   Grid.Row="4"
                   Foreground="#B42318"
                   FontSize="12"
                   VerticalAlignment="Top"
                   Margin="0,0,0,6"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource SubtitleColor_Cancel}"
                    Style="{StaticResource DialogButton}"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button x:Name="ApplyButton"
                    Content="{DynamicResource SubtitleColor_Apply}"
                    Style="{StaticResource PrimaryDialogButton}"
                    Margin="0"
                    IsDefault="True"
                    Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
