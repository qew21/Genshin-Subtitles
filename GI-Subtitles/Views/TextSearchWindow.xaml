<Window x:Class="GI_Subtitles.Views.TextSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TextSearch_Title}"
        Height="700" Width="1100"
        MinHeight="600" MinWidth="800"
        Icon="../Resources/mask.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F8FAFD"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D8E0EA"/>
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#C5D0DE"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1677FF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0958D9"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6F4FF"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#B54708"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <Style x:Key="WrappedResultText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,18">
            <TextBlock Text="{DynamicResource TextSearch_Title}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{DynamicResource TextSearch_Description}"
                       Margin="0,5,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource TextSearch_Game}"/>
                    <ComboBox x:Name="GameSelector" DisplayMemberPath="Display" SelectedValuePath="Name"
                              SelectionChanged="GameSelector_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource TextSearch_SourceLanguage}"/>
                    <ComboBox x:Name="SourceLanguageSelector" DisplayMemberPath="Display" SelectedValuePath="Code"
                              SelectionChanged="SourceLanguageSelector_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{DynamicResource TextSearch_TargetLanguage}"/>
                    <ComboBox x:Name="TargetLanguageSelector" DisplayMemberPath="Display" SelectedValuePath="Code"
                              SelectionChanged="TargetLanguageSelector_SelectionChanged"/>
                </StackPanel>
                <Button x:Name="SearchButton" Grid.Column="3" Style="{StaticResource PrimaryButton}"
                        Content="{DynamicResource TextSearch_Search}" Click="SearchButton_Click"
                        VerticalAlignment="Bottom" MinWidth="116"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource TextSearch_Input}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource TextSearch_HistoryLabel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="HistorySelector" Grid.Column="2" Width="230" Height="30"
                                  Margin="0,0,8,0" Padding="8,3" MaxDropDownHeight="280"
                                  ToolTip="{DynamicResource TextSearch_History}"
                                  ItemsSource="{Binding SearchHistory}" DisplayMemberPath="DisplayLabel"
                                  SelectionChanged="HistorySelector_SelectionChanged"
                                  IsEnabled="False"/>
                        <Button Grid.Column="3" ToolTip="{DynamicResource TextSearch_Clear}"
                                AutomationProperties.Name="{DynamicResource TextSearch_Clear}"
                                Style="{StaticResource ModernButton}" Width="30" Height="30" MinHeight="30"
                                Padding="0" Click="ClearButton_Click">
                            <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Width="14" Height="14"
                                  Stretch="None" Stroke="{StaticResource TextSecondaryBrush}"
                                  StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBox x:Name="InputTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas" FontSize="14" Height="78"
                                 TextChanged="InputTextBox_TextChanged"/>
                        <TextBlock x:Name="InputPlaceholder" Text="{DynamicResource TextSearch_InputPlaceholder}"
                                   Margin="14,12,14,0" VerticalAlignment="Top"
                                   Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.8"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Margin="0,6,0,0" Text="{DynamicResource TextSearch_ParagraphHint}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource TextSearch_Results}" FontSize="16"
                               FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" CanUserResizeRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  Background="White" BorderBrush="{StaticResource BorderBrush}"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource TextSearch_ColumnLine}" Binding="{Binding LineNumber}" Width="44"
                                                    ElementStyle="{StaticResource WrappedResultText}"/>
                                <DataGridTextColumn Header="{DynamicResource TextSearch_ColumnInput}" Binding="{Binding Input}" Width="0.75*"
                                                    ElementStyle="{StaticResource WrappedResultText}"/>
                                <DataGridTextColumn x:Name="SourceTextColumn" Header="{DynamicResource TextSearch_ColumnMatch}" Binding="{Binding MatchedText}" Width="1.5*"
                                                    ElementStyle="{StaticResource WrappedResultText}"/>
                                <DataGridTextColumn x:Name="TargetTextColumn" Header="{DynamicResource TextSearch_ColumnTranslation}" Binding="{Binding Translation}" Width="1.25*"
                                                    ElementStyle="{StaticResource WrappedResultText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="EmptyResultsPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="320" IsHitTestVisible="False">
                            <TextBlock Text="{DynamicResource TextSearch_EmptyTitle}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center"/>
                            <TextBlock Text="{DynamicResource TextSearch_EmptyDescription}" Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="4,12,4,0"
                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
    </Grid>
</Window>
