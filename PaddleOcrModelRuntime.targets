<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PaddleOcrModelDirectory>$(MSBuildThisFileDirectory)inference</PaddleOcrModelDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PaddleOcrV6Model Include="$(PaddleOcrModelDirectory)\**\*.*" />
  </ItemGroup>
  <Target Name="CopyPaddleOcrV6Models" AfterTargets="Build">
    <Error
      Condition="!Exists('$(PaddleOcrModelDirectory)\Det\V6\PP-OCRv6_small_det_infer\slim.onnx')"
      Text="PP-OCRv6 detection model is missing from the repository." />
    <Error
      Condition="!Exists('$(PaddleOcrModelDirectory)\Rec\V6\PP-OCRv6_small_rec_infer\slim.onnx')"
      Text="PP-OCRv6 recognition model is missing from the repository." />
    <Copy
      SourceFiles="@(PaddleOcrV6Model)"
      DestinationFiles="@(PaddleOcrV6Model->'$(TargetDir)inference\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
